India_plot <- ggplot() +
geom_col(
data = bars_data,
aes(x = Group_label, y = Value, fill = Variable_label),
position = "stack"
) +
## cost-effective as point
geom_point(
data = point_data,
aes(x = Group_label, y = Value, fill = Variable_label),
shape = 21,
size = 6,
stroke = 1.5
) +
labs(
x = "",
y = "Area (Mha)",
fill = "",
title = ""
) +
scale_fill_manual(
breaks = c(
"Wide scale restoration",
"Mosaic restoration",
"Protected areas",
"Tree cover restoration potential",
"Technical restoration potential (2020-2050)",
"Cost-effective restoration potential (2020-2050)"
),
values = c(
"Wide scale restoration" = "#7570b3",
"Mosaic restoration" = "lightblue",
"Protected areas" = "#FFD54F",
"Tree cover restoration potential" = "#a6761d",
"Technical restoration potential (2020-2050)" = "#1b9e77",
"Cost-effective restoration potential (2020-2050)" = "#f781bf"
),
guide = guide_legend(ncol = 2, byrow = TRUE)
) +
theme_minimal() +
theme(
text = element_text(family = "sans", color = "black", size = 30, face = "bold"),
axis.text.x = element_text(size = 16),
axis.title.y = element_text(size = 24),
legend.position = "top",
legend.box = "horizontal"
)
India_plot
# Save the plot
figure_directory <- here("output", "figures")
filename <- paste0(format(Sys.Date(),format = "%y%m%d"), "_", gsub(" ", "_", "India_restoration"), ".png")
png(
filename = here(figure_directory, filename),
units = "in", height = 12, width = 20, res = 300
)
print(India_plot)
dev.off()
