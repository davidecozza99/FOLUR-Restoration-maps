Variable == "ars_tech_ha" ~ "ars_tech_ha_tot",
Variable == "ars_feas_ha" ~ "ars_feas_ha_tot"
),
Value = Value * 35  # Because the variables are expressed in ha/yr, and the period considered is 2015-2050
)
# Combine original data with totals
RoeetAl <- bind_rows(RoeetAl, totals) %>%
# Assign units and descriptions
mutate(
source = "Austinetal_2020 in Roeetal_2021",
unit = case_when(
Variable %in% c("ars_tech", "ars_feas") ~ "MtCO2 yr-1",
Variable %in% c("ars_techcum", "ars_feascum", "refor_techcum", "refor_feascum") ~ "MtCO2",
Variable %in% c("ars_tech_ha", "ars_feas_ha") ~ "ha yr-1",
Variable %in% c("ars_tech_ha_tot", "ars_feas_ha_tot") ~ "ha (total over 35 yrs)",
TRUE ~ NA_character_
),
description = case_when(
Variable == "ars_tech" ~ "Technical Potential annual for Afforestation and reforestation",
Variable == "ars_techcum" ~ "Technical Potential cumulative for Afforestation and reforestation",
Variable == "ars_tech_ha" ~ "Technical Area annual for Afforestation and reforestation",
Variable == "ars_feas" ~ "Cost-effective Potential annual for Afforestation and reforestation",
Variable == "ars_feascum" ~ "Cost-effective Potential cumulative for Afforestation and reforestation",
Variable == "ars_feas_ha" ~ "Cost-effective Area annual for Afforestation and reforestation",
Variable == "ars_tech_ha_tot" ~ "Technical Total Area over 35 years for Afforestation and reforestation",
Variable == "ars_feas_ha_tot" ~ "Cost-effective Total Area over 35 years for Afforestation and reforestation",
Variable == "refor_techcum" ~ "Technical Potential cumulative for reforestation",
Variable == "refor_feascum" ~ "Cost-effective Potential cumulative for reforestation",
TRUE ~ NA_character_
)
) %>%
select(iso3, Variable, Value, unit, description, source) %>%
drop_na() %>%
distinct()
Bastinetal_potential <- read_excel(here("data/input/Bastinetal_potential.xlsx"))
Shyamsundaretal <- read_excel(here("data/input/Shyamsundaretal.xlsx"))
Busch_2019 <- read_excel(here("data/input/Busch_2019.xlsx")) %>%
pivot_longer(
cols = -iso3,
names_to = "Variable",
values_to = "Value"
)
# Create total area rows
totals <- Busch_2019 %>%
filter(Variable %in% c("refor_tech_ha", "refor_feas_ha")) %>%
mutate(
Variable = case_when(
Variable == "refor_tech_ha" ~ "refor_tech_ha_tot",
Variable == "refor_feas_ha" ~ "refor_feas_ha_tot"
),
Value = Value * 30 # Because the variables are expressed in ha/yr, and the period considered is 2020-2050
)
# Combine original data with totals
Busch_2019 <- bind_rows(Busch_2019, totals) %>%
mutate(
source = "Busch_2019 in Roeetal_2021",
unit = case_when(
Variable %in% c("refor_tech", "refor_feas") ~ "MtCO2 yr-1",
Variable %in% c("refor_techcum", "refor_feascum", "refor_techcum", "refor_feascum") ~ "MtCO2",
Variable %in% c("refor_tech_ha", "refor_feas_ha") ~ "ha yr-1",
Variable %in% c("refor_tech_ha_tot", "refor_feas_ha_tot") ~ "ha (total over 30 yrs)",
TRUE ~ NA_character_
),
description = case_when(
Variable == "refor_tech" ~ "Technical Potential annual for Reforestation (tropics)",
Variable == "refor_techcum" ~ "Technical Potential cumulative for Reforestation (tropics)",
Variable == "refor_tech_ha" ~ "Technical Area annual Reforestation (tropics)",
Variable == "refor_feas" ~ "Cost-effective Potential annual Reforestation (tropics)",
Variable == "refor_feascum" ~ "Cost-effective Potential cumulative Reforestation (tropics)",
Variable == "refor_feas_ha" ~ "Cost-effective Area annual Reforestation (tropics)",
Variable == "refor_tech_ha_tot" ~ "Technical Area total over 30 years Reforestation (tropics)",
Variable == "refor_feas_ha_tot" ~ "Cost-effective Area total over 30 years Reforestation (tropics)",
Variable == "refor_techcum" ~ "Technical Potential cumulative for reforestation",
Variable == "refor_feascum" ~ "Cost-effective Potential cumulative for reforestation",
TRUE ~ NA_character_
)
) %>%
select(iso3, Variable, Value, unit, description, source) %>%
drop_na() %>%
distinct()
restoration_db <- Bastin_Zonal_Statistics %>%
rbind(Aboveground_and_Belowground_Biomass_Carbon_Density_Zonal_Statistics) %>%
rbind(Chaturvedi_ZonalStatistics) %>%
rbind(Griscom_Zonal_Statistics) %>%
rbind(Hasler_Zonal_Statistics) %>%
rbind(Walker_Zonal_Statistics) %>%
rbind(Williams_Zonal_Statistics) %>%
rbind(Potapovetal) %>%
rbind(RoeetAl) %>%
rbind(Bastinetal_potential) %>%
rbind(Shyamsundaretal) %>%
rbind(Busch_2019) %>%
distinct(iso3, Variable, .keep_all = TRUE) %>%
drop_na()
write.xlsx(restoration_db,  file = here("data", "output", "restoration_db.xlsx"), row.names = FALSE)
###  Adding columns criteria in the dataset ###
restoration_db_final <- restoration_db %>%
# Keeping just the variables directly available in the database
filter(!Variable %in% c("country_area",
"Biomass_Carbon_Density",
"Tree_cover_ha",
"Reforestation_carbonseq_density",
"ClimateImpact_treecoverrestoration_density",
"Potential_carbonland_density",
"Potential_forestregeneration_percent",
"ars_tech_ha_tot", "ars_feas_ha_tot",
"refor_tech_ha_tot", "refor_feas_ha_tot",
"ars_techcum", "ars_feascum", "refor_techcum", "refor_feascum"
)) %>%
# select(description, unit, source) %>%
mutate(
# Rename description for specific sources
description = case_when(
source %in% c("Chaturvedietal_2018", "Potapovetal_2011") ~ "Restoration area",
TRUE ~ description
),
Focus_trees = ifelse(
source %in% c("ORNL_DAAC", "Walkeral_2022"),
"N", "Y"
),
# Focus_tropical = ifelse(
#   source %in% c("Williamsal_2024", "Busch_2019 in Roeetal_2021", "Shyamsundaretal_2022"),
#   "Y", "N"
# ),
Climatic_zone = case_when(
source %in% c("Williamsal_2024", "Busch_2019 in Roeetal_2021", "Shyamsundaretal_2022") ~ "Tropical",
TRUE ~ "Any"
),
Areas_for_restoration = case_when(
source == "Chaturvedietal_2018" ~ "Exclude grassland, areas under surface and groundwater irrigation, croplands with more than 40 percent tree canopy cover, national parks, sanctuaries, State reserves, wildlife reserves, and urban and built-up areas",
source == "Bastinetal_2019" ~ "Exclude cropland and urban areas",
source == "Hasleretal_2024" ~ "Include evergreen, needleleaf forests, evergreen broadleaf forests, deciduous needleleaf, forests, deciduous broadleaf forests, mixed forests, and woody savanna",
source == "ORNL_DAAC" ~ "Woody, grassland, cropland, and tundra biomass",
source == "Shyamsundaretal_2022" ~"Tropical croplands, pasturelands, and degraded forestlands",
source == "Potapovetal_2011" ~ "Exclude naturally nonforested lands, forest without restoration needs, urban areas and remote restoration",
source == "Griscometal_2017" ~ "Exclude existing cropland area",
source == "Williamsal_2024" ~ "Exclude existing cropland, grazing and urban areas",
# source == "Austinetal_2020 in Roeetal_2021" ~ "Na",
source == "Busch_2019 in Roeetal_2021" ~ "Tropical forested countries and biomes",
source == "Williamsal_2024" ~ "Focus on afforestation/reforestation. Exclude mangrove and peatland restoration",
TRUE ~ "All"
),
Include_existing_trees = case_when(
source %in% c("ORNL_DAAC", "Chaturvedietal_2018" ) ~ "Y",
source %in% c("Griscometal_2017", "Hasleretal_2024", "Walkeral_2022",
"Williamsal_2024","Potapovetal_2011",
"Austinetal_2020 in Roeetal_2021",
"Bastinetal_2019",
"Shyamsundaretal_2022", "Busch_2019 in Roeetal_2021") ~ "N",
TRUE ~ NA_character_
),
Available_map_on_FABLE_Zonal_Statistics_Extractor = case_when(
source == "Bastinetal_2019" & Variable == "Tree_cover" ~ "Y",
source == "Bastinetal_2019" & Variable == "Tree_cover_potential" ~ "N",
source %in% c("ORNL_DAAC", "Chaturvedietal_2018",
"Griscometal_2017", "Hasleretal_2024",
"Walkeral_2022", "Williamsal_2024") ~ "Y",
source %in% c("Potapovetal_2011", "Austinetal_2020 in Roeetal_2021",
"Shyamsundaretal_2022", "Busch_2019 in Roeetal_2021") ~ "N",
TRUE ~ NA_character_
),
Composite_variable = ifelse(
source %in% c("Chaturvedietal_2018", "Potapovetal_2011"), "Y", "N"
),
# Climate_scenario = case_when(
#   source %in% c("ORNL_DAAC", "Chaturvedietal_2018" ) ~ "Y",
#   source %in% c("Griscometal_2017", "Hasleretal_2024", "Walkeral_2022",
#                 "Williamsal_2024","Potapovetal_2011",
#                 "Austinetal_2020 in Roeetal_2021",
#                 "Bastinetal_2019",
#                 "Shyamsundaretal_2022", "Busch_2019 in Roeetal_2021") ~ "N",
#   TRUE ~ NA_character_
# ),
Resolution = case_when(
source %in% c("Bastinetal_2019") ~ "1 km", #30 arc sec
source %in% c("Griscometal_2017") ~ "1 Km", #0.0083°
source %in% c("Hasleretal_2024") ~ "500 m", #0.005°
source %in% c("ORNL_DAAC") ~ "300 m",
source %in% c("Potapovetal_2011") ~ "1 Km",
source %in% c("Shyamsundaretal_2022") ~ "Na",
source %in% c("Walkeral_2022") ~ "500 m",
source %in% c("Williamsal_2024", "Busch_2019 in Roeetal_2021") ~ "30 m",
TRUE ~ "Na"
)
)%>%
select(-Variable) %>%
distinct() %>%
rename(variable = description) %>%
select(source, variable, unit, Resolution, Focus_trees, Climatic_zone, Areas_for_restoration, Include_existing_trees, Available_map_on_FABLE_Zonal_Statistics_Extractor, Composite_variable) %>%
distinct()
